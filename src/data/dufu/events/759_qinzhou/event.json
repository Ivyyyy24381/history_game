            },
            {
              "speaker": "chuilao",
              "speakerName": "垂老老兵",
              "text": "孰知是死别，且复伤其寒。"
            },
            {
              "speaker": "narrator",
              "speakerName": "旁白",
              "text": "（《垂老别》）"
            }
          ]
