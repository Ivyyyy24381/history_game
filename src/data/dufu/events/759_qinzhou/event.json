    {
      "id": "resign_choice",
      "type": "forced_choice",
      "background": "/assets/dufu/events/759_qinzhou/backgrounds/huazhou_yamen.webp",
      "title": "弃官",
      "narrative": "杜甫回到华州，案上堆满征兵文书。一支笔。一张白纸。",
      "question": "这官，做还是不做？",
      "options": [
        {
          "id": "stay_in_office",
          "text": "继续做官",
          "correct": false,
          "response": {
            "speaker": "dufu",
            "speakerName": "杜甫",
            "text": "官小，救不得他们。但官在，至少能减一户。\n（但每一份文书都在拉走人。）"
          }
        },
        {
          "id": "resign",
          "text": "弃官西行",
          "correct": true,
          "response": {
            "speaker": "dufu",
            "speakerName": "杜甫",
            "text": "这官，做不下去了。\n（提笔写下辞呈，绶带与官印一并交回。）"
          }
        },
        {
          "id": "remonstrate",
          "text": "上书直谏",
          "correct": false,
          "response": {
            "speaker": "dufu",
            "speakerName": "杜甫",
            "text": "书上去，石沉大海。我已上过一次。"
          }
        }
      ],
      "conclusion": {
        "narrative": "乾元二年秋，杜甫弃华州司功参军之职，携家西赴秦州。\n这是他一生中第一次（也是最后一次）自己离开仕途。"
      }
    },
