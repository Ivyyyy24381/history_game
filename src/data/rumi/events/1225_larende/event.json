          "name": "大马士革",
          "x": 30.2,
          "y": 40.3,
          "dialogues": [
            {
              "speaker": "narrator",
              "speakerName": "旁白",
              "text": "学者最多的城。八年后，鲁米会一个人回到这里读书。"
