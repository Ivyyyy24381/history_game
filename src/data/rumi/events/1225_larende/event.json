          "id": "malatya",
          "name": "马拉蒂亚",
          "x": 33.9,
          "y": 21.7,
          "dialogues": [
            {
              "speaker": "narrator",
              "speakerName": "旁白",
              "text": "翻过山口进了安纳托利亚。父亲在这里讲了一阵经。"
            }
          ]
        },
        {
          "id": "erzincan",
          "name": "埃尔津詹",
          "x": 36.1,
          "y": 16.3,
          "dialogues": [
            {
              "speaker": "narrator",
              "speakerName": "旁白",
              "text": "塞尔柱人的地界。语言换了，饭也换了。"
            }
          ]
        },
        {
          "id": "larende",
          "name": "拉兰达",
          "x": 24.5,
          "y": 26.2,
          "isKey": true,
          "dialogues": [
            {
              "speaker": "mother",
              "speakerName": "母亲",
              "text": "「就在这儿吧。我走不动了。」"
            }
          ]
        }
      ],
      "narrative": ""
    },
    {
      "id": "courtyard",
      "type": "explore",
      "background": "/assets/rumi/events/1225_larende/backgrounds/larende_courtyard.webp",
      "title": "拉兰达的院子",
      "narrative": "安纳托利亚的一座小城。石砌的院子，葡萄架，廊下挂起了彩色的布幔——家里要办喜事。",
      "instruction": "院子里有三个人。都说说话。",
      "npcs": [
        {
          "id": "gowhar",
          "name": "高哈尔",
          "portrait": "/assets/rumi/npcs/gowhar.webp",
          "position": {
            "x": 26,
            "y": 86
          },
          "scale": 2.5,
          "dialogues": [
            {
              "speaker": "gowhar",
              "speakerName": "高哈尔",
              "text": "「我父亲和你父亲，在撒马尔罕就是朋友了。」"
            },
            {
              "speaker": "gowhar",
              "speakerName": "高哈尔",
              "text": "「我们两家人，是在同一条路上走散又遇上的。」"
            }
          ]
        },
        {
          "id": "mother_mumina",
          "name": "母亲穆敏娜",
          "portrait": "/assets/rumi/npcs/mother_mumina.webp",
          "position": {
            "x": 52,
            "y": 88
          },
          "scale": 2.5,
          "dialogues": [
            {
              "speaker": "mother_mumina",
              "speakerName": "穆敏娜",
              "text": "「我们从撒马尔罕走到这里，走了六年。」"
            },
            {
              "speaker": "mother_mumina",
              "speakerName": "穆敏娜",
              "text": "「你在路上长大了。我在路上老了。」"
            }
          ]
        },
        {
          "id": "baha_walad",
          "name": "父亲巴哈丁",
          "portrait": "/assets/rumi/npcs/baha_walad.webp",
          "position": {
            "x": 76,
            "y": 86
          },
          "scale": 2.6,
          "dialogues": [
            {
              "speaker": "baha_walad",
              "speakerName": "巴哈丁",
              "text": "「婚约你自己写。」"
            },
            {
              "speaker": "baha_walad",
              "speakerName": "巴哈丁",
              "text": "「笔在桌上。纸也在。」"
            }
          ]
        }
      ],
      "requiredTalks": 3
    },
    {
      "id": "contract_direction",
      "type": "predict_reveal",
      "background": "/assets/rumi/events/1225_larende/backgrounds/marriage_contract_desk.webp",
      "situation": "矮桌上摊着一张空白的婚约纸。芦苇笔、墨壶、撒沙罐，旁边一支红烛。",
      "question": "波斯文写婚约，笔从哪边起？",
      "himLabel": "实际",
      "options": [
        {
          "id": "ltr",
          "text": "从左往右，和汉字横排一样"
        },
        {
          "id": "rtl",
          "text": "从右往左"
        },
        {
          "id": "ttb",
          "text": "从上往下，一列一列写"
        }
      ],
      "actual": "rtl",
      "sameNote": "对了。那你已经知道，这一家人的书，是从我们眼里的「最后一页」翻起的。",
      "diffNote": "不是那一边。——",
      "reveal": "波斯文用阿拉伯字母，从右往左写。\n书也从我们眼里的「最后一页」翻起。",
      "consequence": "鲁米一辈子用这种文字写诗。光《玛斯纳维》就有约两万五千联，每一联都是从右往左写下来的。"
    },
