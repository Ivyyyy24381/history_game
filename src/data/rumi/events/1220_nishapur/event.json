  "year": "1220",
  "type": "interactive",
  "_note": "鲁米线 1220：药香铺探索 → 百鸟会议（带《百鸟会议》古画卡）→ 赠书传说 → 内沙布尔陷落。",
  "phases": [
    {
      "id": "attar_shop",
      "type": "explore",
      "background": "/assets/rumi/events/1220_nishapur/backgrounds/nishapur_attar_shop.png",
      "title": "内沙布尔 · 药香铺",
      "narrative": "驼队在内沙布尔歇脚。父亲带你走进一间铺子——墙上一格格全是药材和香料，铜秤，玫瑰水瓶。\n「阿塔尔」这个名字，本来的意思就是「卖香料和药的人」。",
      "instruction": "铺子里有三个人。都说说话。",
      "npcs": [
        {
          "id": "attar_apprentice",
          "name": "学徒",
          "portrait": "/assets/rumi/npcs/attar_apprentice.png",
          "position": {
            "x": 22,
            "y": 86
          },
          "scale": 2.4,
          "dialogues": [
            {
              "speaker": "attar_apprentice",
              "speakerName": "学徒",
              "text": "「客人要什么？乳香、没药、玫瑰水，我们都有。」"
            },
            {
              "speaker": "attar_apprentice",
              "speakerName": "学徒",
              "text": "「师父？他白天称药，晚上写东西。写的什么我们也看不懂。」"
            }
          ]
        },
        {
          "id": "baha_walad",
          "name": "父亲巴哈丁",
          "portrait": "/assets/rumi/npcs/baha_walad.png",
          "position": {
            "x": 50,
            "y": 88
          },
          "scale": 2.6,
          "dialogues": [
            {
              "speaker": "baha_walad",
              "speakerName": "巴哈丁",
              "text": "「这位老先生的诗，呼罗珊没有人没读过。」"
            },
            {
              "speaker": "baha_walad",
              "speakerName": "巴哈丁",
              "text": "「去，你自己跟他说话。」"
            }
          ]
        },
        {
          "id": "attar",
          "name": "阿塔尔",
          "portrait": "/assets/rumi/npcs/attar.png",
          "position": {
            "x": 76,
            "y": 86
          },
          "scale": 2.8,
          "dialogues": [
            {
              "speaker": "attar",
              "speakerName": "阿塔尔",
              "text": "「我白天称药，晚上写诗。」"
            },
            {
              "speaker": "attar",
              "speakerName": "阿塔尔",
              "text": "「药治身上的病。诗治别的。」"
            },
            {
              "speaker": "attar",
              "speakerName": "阿塔尔",
              "text": "「孩子，坐下。我给你讲个故事——讲一群鸟，去找它们的王。」"
            }
          ]
        }
      ],
      "requiredTalks": 3
    },
    {
