          "leave": 4,
          "excuse": {
            "bird": "猎鹰",
            "text": "「我在国王的手腕上就很好。」",
            "reply": "「国王的手腕，也会把你扔下来。」"
          },
          "kind": "gust",
          "tip": "风要来了——按住冲刺，把鸟群收拢"
