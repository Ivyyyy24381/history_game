{
  "id": "1300_priore",
  "title": "执政官·禧年",
  "year": "1300",
  "type": "interactive",
  "phases": [
    {
      "id": "lectern_intro",
      "type": "transition",
      "background": "/assets/dante/events/1265_firenze/backgrounds/lectern_1373.webp",
      "title": "讲坛引子",
      "transitionText": "讲坛上，薄伽丘写下一个年份：1300。",
      "announcement": {
        "text": "薄伽丘：「记住这一年。史实里，他在这一年当上执政官；而《神曲》的故事，也被他放在这一年——人生的中点。为什么？听完你们就懂了。」",
        "style": "imperial_decree",
        "title": "讲坛"
      },
      "narrative": "",
      "nextPhase": "giubileo"
    },
    {
      "id": "giubileo",
      "type": "map_travel",
      "background": "/assets/dante/maps/route_1300_giubileo.webp",
      "title": "禧年朝圣",
      "travelNarrative": "教皇卜尼法斯八世首创「禧年」：凡今年至罗马朝圣者，罪愆全赦。二十万人涌向罗马——但丁也在其中。",
      "instruction": "沿路线点击每一站。",
      "requireAll": true,
      "waypoints": [
        {
          "id": "firenze_partenza",
          "name": "佛罗伦萨·出发",
          "x": 22,
          "y": 29,
          "dialogues": [
            {
              "speaker": "dante",
              "speakerName": "但丁",
              "text": "满城的人都在收拾行装。去罗马！去禧年！"
            }
          ]
        },
        {
          "id": "strada",
          "name": "法兰奇纳古道",
          "x": 42,
          "y": 51,
          "dialogues": [
            {
              "speaker": "narrator",
              "speakerName": "旁白",
              "text": "古道上人流不断：香客、商贩、乞丐、贵妇的轿子。所有语言都在说同一个词——罗马。"
            }
          ]
        },
        {
          "id": "roma_porta",
          "name": "罗马城门",
          "x": 60,
          "y": 64,
          "isKey": true,
          "dialogues": [
            {
              "speaker": "narrator",
              "speakerName": "旁白",
              "text": "城门内外，人流如蚁。桥上的人群被分成两列对向而行，才不至于踩踏。"
            },
            {
              "speaker": "dante",
              "speakerName": "但丁",
              "text": "像军队渡桥，分两列……这个画面，我记下了。"
            }
          ]
        }
      ],
      "nextPhase": "porta",
      "narrative": ""
    },
    {
      "id": "porta",
      "type": "explore",
      "background": "/assets/dante/events/1300_priore/backgrounds/roma_porta_giubileo.webp",
      "title": "禧年的罗马",
      "narrative": "罗马。二十万朝圣者把街道挤成河流。",
      "instruction": "点击画面中的人与景。",
      "dufu_pose": "citizen/robe",
      "npcs": [
        {
          "id": "crowd_columns",
          "name": "分成两列的人流",
          "portrait": "",
          "position": {
            "x": 24,
            "y": 78
          },
          "isClue": true,
          "dialogues": [
            {
              "speaker": "narrator",
              "speakerName": "旁白",
              "text": "维持秩序的兵丁把桥面从中隔开：去圣彼得堂的靠一边，回程的靠另一边。"
            },
            {
              "speaker": "dante",
              "speakerName": "但丁",
              "text": "多年以后，我写地狱第八层的恶囊：罪人分两列对向而行——「就像禧年时罗马桥上的人流」。"
            }
          ]
        },
        {
          "id": "pilgrim_song",
          "name": "香客的歌声",
          "portrait": "",
          "position": {
            "x": 69,
            "y": 67
          },
          "dialogues": [
            {
              "speaker": "narrator",
              "speakerName": "旁白",
              "text": "各地口音的圣歌混在一处。有人一路膝行，膝盖磨出了血。"
            }
          ]
        },
        {
          "id": "coin_chest",
          "name": "祭坛边的钱箱",
          "portrait": "/assets/dante/props/florin_coin.webp",
          "position": {
            "x": 46,
            "y": 36
          },
          "scale": 0.4,
          "isClue": true,
          "dialogues": [
            {
              "speaker": "narrator",
              "speakerName": "旁白",
              "text": "祭坛边，教士用长耙把如山的献金拢进箱里，昼夜不停。"
            },
            {
              "speaker": "dante",
              "speakerName": "但丁",
              "text": "赦罪与金币，在同一张祭坛上交割。"
            }
          ]
        }
      ],
      "requiredTalks": 3,
      "nextPhase": "san_pietro"
    },
    {
      "id": "san_pietro",
      "type": "transition",
      "background": "/assets/dante/events/1300_priore/backgrounds/san_pietro_old.webp",
      "title": "圣彼得堂 · 教皇的影子",
      "transitionText": "圣彼得堂前。远处的高台上，一个金冠的身影接受着二十万人的欢呼。\n没有对话。只有威压。",
      "announcement": {
        "text": "卜尼法斯八世：「凡于此圣年虔诚朝觐使徒之墓者，罪愆全赦。」",
        "style": "imperial_decree",
        "title": "禧年诏书"
      },
      "dufu_reaction": {
        "portrait": "/assets/dante/hero/citizen/robe.webp",
        "text": "他把天堂的钥匙，铸成了人间的权杖。记住这个人——卜尼法斯。"
      },
      "narrative": "",
      "nextPhase": "petitions"
    },
    {
      "id": "petitions",
      "type": "petition",
      "background": "/assets/dante/events/1300_priore/backgrounds/palazzo_priori.webp",
      "meterLabel": "佛罗伦萨 · 安定",
      "startStability": 70,
