          "id": "p2_dark",
          "x": 0,
          "y": 50,
          "w": 36.6,
          "h": 50,
          "dialogues": [
            {
              "speaker": "narrator",
              "speakerName": "旁白",
              "text": "画面渐暗。案头的文书，慢慢化作藤蔓与枝条。"
            }
